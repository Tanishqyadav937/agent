# Copy this to .env and fill in your API keys

# ========================
# CORE API KEYS (Required)
# ========================
DEEPGRAM_API_KEY=your_deepgram_key_here
GEMINI_API_KEY=your_gemini_key_here

# ========================
# LLM Provider Configuration
# ========================
# Production: Use 'gemini' (Google Generative AI)
# Development: Use 'local' (Ollama)
LLM_PROVIDER=gemini

# For local provider only (Ollama development)
# qwen2.5:7b-instruct recommended for tool-calling support
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# Enable function calling / tool use (requires model with tool support)
TOOLS_ENABLED=true

# ========================
# Embedding & Memory (Chroma)
# ========================
# Development: Local Chroma server
CHROMA_URL=http://localhost:8000

# Production: Chroma Cloud (https://www.trychroma.com/)
# Replace with your Chroma Cloud URL and API key
# CHROMA_URL=https://api.trychroma.com
# CHROMA_API_KEY=your_chroma_api_key_here

EMBEDDING_MODEL=mxbai-embed-large

# ========================
# Tool API Keys (Optional)
# ========================
# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweather_key_here

# Web Search API (Serper)
SERPER_API_KEY=your_serper_key_here

# Calendar API (Google Calendar) - for create_calendar_event tool
GOOGLE_CALENDAR_CLIENT_ID=your_google_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALENDAR_REFRESH_TOKEN=your_google_refresh_token_here

# ========================
# Server Configuration
# ========================
PORT=3000
NODE_ENV=production
