# Copy this to .env and fill in your API keys

DEEPGRAM_API_KEY=your_deepgram_key_here

# LLM Provider Configuration
# Options: local (Ollama) or cloud (Gemini)
LLM_PROVIDER=local

# For cloud provider (Gemini)
GEMINI_API_KEY=your_gemini_key_here

# For local provider (Ollama)
# qwen2.5:7b-instruct recommended for tool-calling support
# or use your fine-tuned model: my-assistant
OLLAMA_MODEL=my-assistant
OLLAMA_BASE_URL=http://localhost:11434

# Enable function calling / tool use (requires model with tool support)
# Set to false for basic chat-only models like fine-tuned assistants
TOOLS_ENABLED=false

# Embedding Model Configuration (for memory/Chroma)
EMBEDDING_MODEL=nomic-embed-text

# Function Calling / Tools Configuration
# Weather API (OpenWeatherMap)
OPENWEATHER_API_KEY=your_openweather_key_here

# Calendar API (Google Calendar)
GOOGLE_CALENDAR_CLIENT_ID=your_google_client_id_here
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALENDAR_REFRESH_TOKEN=your_google_refresh_token_here

# Web Search API (Serper or similar)
SERPER_API_KEY=your_serper_key_here

# Server port
PORT=3000
